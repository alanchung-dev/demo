# ── Google 登入（OIDC）設定範本 ── DEMO 展示版 ─────────────────────────────────
# 用法：
#   1) 本機：複製本檔為 .streamlit/secrets.toml（該檔已被 .gitignore 忽略，不會 commit）
#   2) 線上：把同樣內容貼到 Streamlit Cloud → App → Settings → Secrets
#   3) 兩處的 redirect_uri 不同（見下方）
#
# 展示版不讀任何 Google Sheet，所以這裡「只需要」登入設定，不需要服務帳號。
#
# ⚠️ 要讓「任何 Google 帳號」都能登入，Google Cloud Console 的 OAuth 同意畫面
#    （Google Auth Platform → Audience）必須是：
#      - User type = External（Internal 只允許自己組織的帳號，外部客戶會被 Google 擋下）
#      - Publishing status = In production（Testing 狀態只有列入 Test users 的帳號能登入）
#    建議為展示版另建一組 OAuth Client，不要與正式站共用。
# ────────────────────────────────────────────────────────────────────────────

[auth]
# 本機開發用（streamlit run app.py 預設 8501 埠）：
redirect_uri = "http://localhost:8501/oauth2callback"
# ↑ 部署到 Streamlit Cloud 時，改成展示站網址 + /oauth2callback，例如：
#   redirect_uri = "https://<your-demo-app>.streamlit.app/oauth2callback"
# 這個網址也要登記在該 OAuth Client 的「已授權的重新導向 URI」。

# 隨機長字串（用來簽章登入 cookie）。可用以下指令產生後貼上：
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "PUT_A_LONG_RANDOM_STRING_HERE"

[auth.google]
# 來自 Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
